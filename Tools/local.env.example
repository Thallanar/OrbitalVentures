# Copie para Tools/local.env e ajuste para a sua máquina. O local.env fica fora do git.

# Pasta da Unreal Engine extraída (a que contém Engine/).
UE_ROOT="/caminho/para/UnrealEngine/5.8.2"

# Cache de shaders e dados derivados (DDC). Cresce dezenas de GB: aponte para um disco com espaço.
UE_DDC_PATH="/caminho/para/UnrealEngine/DDC"
